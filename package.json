{
  "name": "main-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:lib": "ng test ng-text-highlight",
    "test:lib:ci": "ng test ng-text-highlight --watch=false --browsers=ChromeHeadless",
    "test:lib:coverage": "ng test ng-text-highlight --code-coverage",
    "postinstall": "npm run build:library",
    "build:library": "ng build ng-text-highlight --configuration=production",
    "build:app": "ng build main-app --configuration=production",
    "build": "npm run build:library && npm run build:app",
    "build:prod": "npm run build:library && npm run build:app",
    "serve": "npm run build:library && ng serve main-app",
    "serve:prod": "npm run build:library && ng serve main-app --configuration=production",
    "patch-package-github": "node scripts/patch-package-json-github.js"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.22",
    "@angular/common": "^19.2.22",
    "@angular/compiler": "^19.2.22",
    "@angular/core": "^19.2.22",
    "@angular/forms": "^19.2.22",
    "@angular/platform-browser": "^19.2.22",
    "@angular/platform-browser-dynamic": "^19.2.22",
    "@angular/router": "^19.2.22",
    "ng-text-highlight": "^2.0.4",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.26",
    "@angular/cli": "~19.2.26",
    "@angular/compiler-cli": "^19.2.22",
    "@types/jasmine": "~4.3.6",
    "jasmine-core": "~4.6.1",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^19.2.2",
    "typescript": "~5.8.3"
  }
}
